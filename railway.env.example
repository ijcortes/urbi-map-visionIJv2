# ══════════════════════════════════════════════════════════════
# Railway environment variables — Medellin Social
# Pega estas variables en Railway → Service → Variables
# ══════════════════════════════════════════════════════════════

# ── Servicio Frontend ─────────────────────────────────────────
# URL del backend FastAPI en Railway (sin trailing slash)
VITE_API_URL=https://YOUR-API-SERVICE.up.railway.app

# Mapbox public token (safe to expose — pk.* prefix)
VITE_MAPBOX_TOKEN=pk.REPLACE_WITH_YOUR_PUBLIC_MAPBOX_TOKEN

# Google Sign-In button — same value as GOOGLE_CLIENT_ID below, public (Vite-exposed)
VITE_GOOGLE_CLIENT_ID=

# Frontend error reporting (optional; Sentry stays off when empty). Must be set as a Railway
# variable AND is passed to the Docker build as an ARG (see Dockerfile).
VITE_SENTRY_DSN=

# ── Servicio Backend (Dockerfile.api) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/urbidata
SECRET_KEY=genera_un_secret_key_largo_aqui
# REQUERIDA — la API crashea al arrancar sin esto (mín 32 chars).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Setear en servicios API y cron. Rotarla desloguea a todos los usuarios.
JWT_SECRET=genera_un_jwt_secret_de_minimo_32_caracteres
CORS_ORIGINS=https://YOUR-FRONTEND.up.railway.app
USD_TO_COP=4100
EUR_TO_COP=4500
AIRROI_API_KEY=pon_tu_api_key_aqui

# ── Google Sign-In + Gmail API ──────────────────────────────────────────
# Ver docs/GOOGLE_AUTH_SETUP.md — un solo OAuth Client (Web application) para
# ambos usos. Sin GOOGLE_REFRESH_TOKEN, el envío de correos cae a SMTP_* si
# están seteadas, o a un stub que solo imprime en logs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=

# ── Listing link health (scraping/link_checker + /api/v1/link-review) ──
# Broken-link candidates are e-mailed for human review; nothing is retired without a click.
LINK_REVIEW_EMAILS=team@easeassociation.com
LINK_REVIEW_SECRET=            # >=16 random chars (HMAC key for Retire/Keep links); generate: openssl rand -hex 32
LINK_REVIEW_BASE_URL=          # public API base used in e-mailed links, e.g. https://<api-host>
LINK_CHECK_CONTACT=            # contact (email/url) shown in the checker's User-Agent
# LINK_CHECK_BOT_URL=  LINK_CHECK_DOMAIN_DELAY=1.0  LINK_CHECK_MAX_GONE_PCT=30  LINK_CHECK_ALERT_WEBHOOK=
# LINK_AUTO_RETIRE_AFTER_DAYS=   # optional, default OFF (unreviewed candidates only ever re-mail after 7 days)

# ── Security hardening (2026-10) ──
# ADMIN_EMAIL account must already exist and be email-verified (sign in once via Google/magic link).
RESERVED_EMAILS=
JWT_EXPIRY_HOURS=168
# Leave ENV unset in production (fail-closed: no /docs, no localhost CORS).
TRUSTED_PROXY_COUNT=
# Optional extra layers (all off when empty):
# CORS_ORIGIN_REGEX=             # wildcard preview origins; prod default allows none (list exact ones in CORS_ORIGINS)
# ADMIN_ALLOWED_IPS=             # comma list: admin API only from these client IPs
# ADMIN_REQUIRE_DB_ROLE=1        # also require usuarios.rol='admin' (0111 seeds it for ADMIN_EMAIL)
# GHL_LEADS_ALLOWED_IPS=         # comma list for /api/v1/ghl/leads; GHL_LEADS_TOKEN accepts "old,new" while rotating
# Scraper services (urbi-cron) only: portal web-client keys, no defaults in code.
HABI_API_KEY=
METROCUADRADO_API_KEY=
