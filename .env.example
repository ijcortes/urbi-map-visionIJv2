# Dev local — copia a .env y completa. start.sh, scraping/ y scripts/ leen
# DATABASE_URL de aquí; ya no hay credenciales embebidas en el código.
# Producción: ver railway.env.example.

# Postgres local (docker "social-postgres", puerto 5433)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/social

# Frontend
VITE_API_URL=http://localhost:8011/api/v1
VITE_MAPBOX_TOKEN=
# Optional: frontend Sentry DSN (empty = Sentry off)
VITE_SENTRY_DSN=

# Auth (mín 32 chars)
SECRET_KEY=
JWT_SECRET=

# ── Listing link health (scraping/link_checker + /api/v1/link-review) ──
# Broken-link candidates are e-mailed for human review; nothing is retired without a click.
LINK_REVIEW_EMAILS=team@easeassociation.com
LINK_REVIEW_SECRET=            # >=16 random chars (HMAC key for Retire/Keep links); generate: openssl rand -hex 32
LINK_REVIEW_BASE_URL=          # public API base used in e-mailed links, e.g. https://<api-host>
LINK_CHECK_CONTACT=            # contact (email/url) shown in the checker's User-Agent
# LINK_CHECK_BOT_URL=  LINK_CHECK_DOMAIN_DELAY=1.0  LINK_CHECK_MAX_GONE_PCT=30  LINK_CHECK_ALERT_WEBHOOK=
# LINK_AUTO_RETIRE_AFTER_DAYS=   # optional, default OFF (unreviewed candidates only ever re-mail after 7 days)

# ── Security (see docs: SECURITY fixes 2026-10) ──
# Admin = this email AND its account must exist + be email-verified. Create it by
# signing in once with Google or a magic link (password registration of this
# address is refused). Comma-separated RESERVED_EMAILS are refused the same way.
ADMIN_EMAIL=
RESERVED_EMAILS=
# JWT lifetime in hours (default 168 = 7 days, max 720). Password reset also revokes sessions.
JWT_EXPIRY_HOURS=168
# Dev-only switches. Production behaviour (no /docs, no localhost CORS) is the DEFAULT.
# ENV=dev      -> enables /docs and localhost CORS origins
ENV=
# Reverse-proxy hops in front of the API (client IP for rate limiting / view dedupe).
# 0 = ignore X-Forwarded-For/X-Real-IP. Unset on Railway = trust Railway's edge headers (legacy).
TRUSTED_PROXY_COUNT=
# Request body caps (bytes): JSON/other 1 MiB, multipart uploads 12 MiB
MAX_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=12582912

# ── Scrapers (portal web-client keys; required, no defaults in code) ──
HABI_API_KEY=
METROCUADRADO_API_KEY=
